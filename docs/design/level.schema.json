{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classicspins.local/capschaos/level.schema.json",
  "title": "Cap Chaos level",
  "description": "One level, fully data-driven (GDD §6). Structural checks live here; semantic checks (floating bottles, hidden-on-ground, colour balance, solvability) are LevelValidator V2–V6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "colors", "stack", "lanes"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^level_[0-9]{4}$",
      "description": "Must equal the file name without extension."
    },
    "slots": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
    "trayCapacity": { "type": "integer", "minimum": 2, "maximum": 6, "default": 4 },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/colorCode" },
      "description": "Palette subset used by this level. Hex values live in DesignTokens, never here."
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows", "layers"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1, "maximum": 16 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 16 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "layers[0] is the GROUND. Each layer is `rows` strings of `cols` chars; string 0 is the BACK row, the last string is the FRONT row (nearest the player).",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[.ROBGPYCNrobgpycn]+$",
              "description": "'.' empty · UPPERCASE visible bottle · lowercase hidden (rainbow) bottle, revealed on reaching the ground."
            }
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Conveyor queues left→right. Element [0] of each lane is the tappable front tray.",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/colorCode" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cameraPreset": { "type": "string", "enum": ["default", "tall", "wide"], "default": "default" },
        "stackScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "default": 1.0 }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["tutorial", "easy", "medium", "hard", "breather"] },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "colorCode": {
      "type": "string",
      "enum": ["R", "O", "B", "G", "P", "Y", "C", "N"],
      "description": "R pink-red · O orange · B blue · G green · P purple · Y yellow · C cyan · N brown"
    }
  }
}
