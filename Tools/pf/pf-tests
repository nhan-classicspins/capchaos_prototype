#!/usr/bin/env python3
# GENERATED by PrototypeFramework 0.4.0 from Documentation~/agent/tools/pf-tests — do not edit here. Change it in the framework repo, then run Framework/Agent Docs/Sync (editor) or Tools/Build/pf-build.sh agentdocs.
"""Run a SET of EditMode test classes in ONE synchronous Unity run, reduced, with a Slow tier.

    pf-tests MapArtTests MapScreenTests    # exactly these classes (short or full names)
    pf-tests --all                         # every class except [Category("Slow")] ones
    pf-tests --auto                        # --all, plus the Slow tier when the diff draws
    pf-tests --all --slow                  # everything, the whole assembly
    pf-tests --list                        # the classes, their test counts, which are Slow
    pf-tests --wait <run-id>               # pick up a run a previous call left running

This is the EditMode door. The per-class `pf-mcp tests-run` sweep it replaces cost 10-13 min per story.
Measured on a SKU, 2026-09-24, with the Editor unfocused, which is how an agent always finds it:

  * AN UNFOCUSED EDITOR TICKS ~6 TIMES A SECOND. With it unfocused, `EditorApplication.update`
    ran 96 times in 15 s. Focused, it ran 9479 times. Unity's async test runner advances one step
    per tick. So MCP `tests-run` on an 8-test class took 10-11 s unfocused and 2.2 s focused: ~7 s
    from `Execute()` to `RunStarted`, plus ~150 ms per test. The class's own work was 0.015 s.
    `ExecutionSettings.runSynchronously = true` runs the whole selection inside one call instead.
    The same 8 tests take ~0.7 s unfocused. 98 tests take 1.7 s instead of 13.4 s.
  * ONE RUN, MANY CLASSES. MCP `tests-run` takes ONE `testClass`, so a suite became 45-60 calls,
    each paying the fixed cost above. `Filter.groupNames` is an OR of regexes, so any set of classes
    is one call here.
  * NO 300 s GATEWAY CAP. MCP `tests-run` holds an HTTP request open for the whole run. The
    gateway answers 504 at ~301 s while Unity keeps going. Here `script-execute` only STARTS the
    run and returns in ~2 s. Unity writes the result to `Library/pf-tests/<id>.result.json`, and
    this tool polls that file. No MCP call is open while tests run.
  * THE SLOW TIER IS WHERE THE TIME IS. The whole suite, synchronous, took 277.5 s. 9 capture/floor
    classes took ~260 s of that (one `RunAll` test alone took 123 s). The other 38 classes took ~18 s.
    Mark the slow ones `[Category("Slow")]`. `--all` skips them and says so. `--auto` includes them
    only when the working tree touches a path that draws. `--slow` forces them in.

Other properties:

  * Stamp reuse. A GREEN run is recorded against a content hash of Assets/, Packages/,
    ProjectSettings/ and every dev-linked package (the same hash `pf-mcp` uses). The same selection
    over unchanged inputs is reported `reused` and not re-run. The typical case is a parent
    re-verifying what its stage agent just proved. `--rerun` forces a run.
  * Turn budget. A run still going after `--turn-budget` seconds (default 240) is left running.
    The call exits 1 with `INCOMPLETE … Tools/pf/pf-tests --wait <id>`. A subagent's prompt cache
    lives five minutes, so a call that blocks longer re-writes the whole context.
  * The Editor stays single-threaded. A synchronous run holds the main thread for its whole
    duration: ~20 s for the fast tier, ~280 s for everything. Other MCP calls queue behind it. So
    never start a second Unity call while one is running, and never run the Slow tier inside an
    edit loop.
  * Anything that returns an IEnumerator ([UnityTest], [UnitySetUp], [UnityTearDown]) cannot run
    synchronously. A selection that contains one falls back to the async runner, and says so.

Exit: 0 green (or reused) · 1 red, or INCOMPLETE (not a failure) · 2 could not run (compile errors,
unsaved scene, unknown class, Editor busy past --wait-ready-max, no Unity-MCP).
"""
import argparse, importlib.machinery, importlib.util, json, os, re, subprocess, sys, time, uuid

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_ASSEMBLY = "Game.Tests.Editor"          # the spine's name; --assembly for anything else
SLOW_CATEGORY = "Slow"                          # same word as the engine-free suite's TestCategories.Slow
# A working tree touching any of these "draws", so --auto includes the Slow tier. Capture and floor
# fixtures render prefabs, sprites and tokens, so a change there can move their pixels with no C#
# reference to connect it. Override with PF_TESTS_DRAW_PATHS (a Python regex, searched per path).
DRAW_PATHS = (r"(^|/)(Views|Content|Capture|UiGate|Art|Prefabs)/|DesignTokens|"
              r"\.(prefab|png|jpg|psd|mat|shader|shadergraph|asset|unity|ttf|otf|uss|uxml|anim|controller)$")
STATE_DIR = os.path.join("Library", "pf-tests")
STAMPS = os.path.join(STATE_DIR, "stamps.json")
POLL = 0.5


def load_pf_mcp():
    """pf-mcp owns the Unity round trip (CLI, payload parsing, readiness probe, input hash): reuse it."""
    sys.dont_write_bytecode = True                  # no __pycache__ beside a synced tool
    path = os.path.join(HERE, "pf-mcp")
    loader = importlib.machinery.SourceFileLoader("pf_mcp", path)
    spec = importlib.util.spec_from_loader("pf_mcp", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def cs(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# The Unity half. Compiled by Unity-MCP's `script-execute` on every call, so it needs no Editor-side
# code in the SKU and no framework assembly change. Main() only validates, refreshes and schedules. The
# run starts on a later EditorApplication.update and reports through files, never through the MCP
# response.
CSHARP = r'''
using System; using System.Collections; using System.Collections.Generic; using System.Globalization;
using System.IO; using System.Linq; using System.Reflection; using System.Text; using System.Text.RegularExpressions;
using UnityEditor; using UnityEditor.SceneManagement; using UnityEditor.TestTools.TestRunner.Api; using UnityEngine;

public class PfTestsRun {
  const string Dir = __DIR__; const string Id = __ID__; const string Asm = __ASM__; const string SlowCat = __CAT__;
  static readonly string[] Want = new string[] { __WANT__ };
  const bool IncludeSlow = __SLOW__; const bool ListOnly = __LIST__;

  static string P(string ext) { return Path.Combine(Dir, Id + ext); }
  static void Put(string path, string text) { var tmp = path + ".tmp"; File.WriteAllText(tmp, text); if (File.Exists(path)) File.Delete(path); File.Move(tmp, path); }
  static string N(double d) { return d.ToString("0.###", CultureInfo.InvariantCulture); }
  static string B(bool b) { return b ? "true" : "false"; }
  static string J(string s) {
    if (s == null) return "null";
    var b = new StringBuilder("\"");
    foreach (var c in s) {
      if (c == '"') b.Append("\\\""); else if (c == '\\') b.Append("\\\\"); else if (c == '\n') b.Append("\\n");
      else if (c == '\t') b.Append("\\t"); else if (c < 32) b.Append(' '); else b.Append(c);
    }
    return b.Append('"').ToString();
  }
  static string JA(IEnumerable<string> xs) { return "[" + string.Join(",", xs.Select(J).ToArray()) + "]"; }
  static string Trim(string s, int n) { return s == null ? null : (s.Length <= n ? s : s.Substring(0, n) + " …"); }

  class Fx { public string Name, Full; public bool Slow, Async; public int Count; }

  public static string Main() {
    try {
      if (EditorApplication.isPlayingOrWillChangePlaymode) return "ERROR: the Editor is in play mode; exit it first";
      if (EditorApplication.isCompiling || EditorApplication.isUpdating) return "BUSY: compiling or importing";
      var dirty = new List<string>();
      for (int i = 0; i < EditorSceneManager.sceneCount; i++) {
        var s = EditorSceneManager.GetSceneAt(i);
        if (s.isDirty) dirty.Add(string.IsNullOrEmpty(s.path) ? s.name : s.path);
      }
      if (dirty.Count > 0) return "ERROR: unsaved scene(s) " + string.Join(", ", dirty.ToArray()) + " - the test runner would prompt to save them; save or discard first";
      Directory.CreateDirectory(Dir);
      AssetDatabase.Refresh();
      if (EditorApplication.isCompiling) return "COMPILING";
      if (EditorUtility.scriptCompilationFailed) return "ERROR: the project has compile errors - fix them first (Tools/pf/typecheck.sh --changed)";
      var api = ScriptableObject.CreateInstance<TestRunnerApi>();
      api.RetrieveTestList(TestMode.EditMode, root => Plan(api, root));
      return "STARTED " + Id;
    } catch (Exception e) { return "ERROR: " + e.GetType().Name + ": " + e.Message; }
  }

  static void Scan(ITestAdaptor t, Fx f) {
    if (t.Categories != null && t.Categories.Contains(SlowCat)) f.Slow = true;
    if (!t.IsSuite) {
      f.Count++;
      if (t.Method != null && typeof(IEnumerator).IsAssignableFrom(t.Method.ReturnType.Type)) f.Async = true;
      return;
    }
    if (t.HasChildren) foreach (var c in t.Children) Scan(c, f);
  }

  static void Walk(ITestAdaptor t, Dictionary<string, Fx> acc, List<string> asms) {
    if (t.IsSuite && t.TypeInfo != null && t.Method == null) {
      var type = t.TypeInfo.Type;
      var asm = type.Assembly.GetName().Name;
      if (!asms.Contains(asm)) asms.Add(asm);
      if (asm != Asm) return;
      Fx f;
      if (!acc.TryGetValue(type.FullName, out f)) {
        f = new Fx { Name = type.Name, Full = type.FullName };
        var flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static;
        foreach (var m in type.GetMethods(flags))
          foreach (var a in m.GetCustomAttributes(true))
            if (a.GetType().Name.StartsWith("Unity") && typeof(IEnumerator).IsAssignableFrom(m.ReturnType)) f.Async = true;
        acc[type.FullName] = f;
      }
      Scan(t, f);
      return;
    }
    if (t.HasChildren) foreach (var c in t.Children) Walk(c, acc, asms);
  }

  static void Plan(TestRunnerApi api, ITestAdaptor root) {
    try {
      var acc = new Dictionary<string, Fx>(); var asms = new List<string>();
      Walk(root, acc, asms);
      var all = acc.Values.OrderBy(f => f.Name).ToList();
      var sel = new List<Fx>(); var skipped = new List<Fx>(); var unknown = new List<string>();
      if (Want.Length > 0) {
        foreach (var w in Want) {
          var hit = all.Where(f => f.Name == w || f.Full == w).ToList();
          if (hit.Count == 0) unknown.Add(w);
          foreach (var h in hit) if (!sel.Contains(h)) sel.Add(h);
        }
      } else foreach (var f in all) (f.Slow && !IncludeSlow ? skipped : sel).Add(f);
      bool sync = !sel.Any(f => f.Async);
      string err = null;
      if (all.Count == 0) err = "no test class in assembly '" + Asm + "' (assemblies with tests: " + string.Join(", ", asms.ToArray()) + ")";
      else if (unknown.Count > 0) err = "unknown class(es) in " + Asm + ": " + string.Join(", ", unknown.ToArray()) + " - `Tools/pf/pf-tests --list` names them all";
      else if (!ListOnly && sel.Count == 0) err = "the selection is empty";
      var sb = new StringBuilder("{");
      sb.Append("\"error\":").Append(J(err)).Append(",\"sync\":").Append(B(sync));
      sb.Append(",\"fixtures\":[").Append(string.Join(",", all.Select(f => "{\"name\":" + J(f.Name) + ",\"full\":" + J(f.Full) + ",\"tests\":" + f.Count + ",\"slow\":" + B(f.Slow) + ",\"async\":" + B(f.Async) + "}").ToArray())).Append("]");
      sb.Append(",\"selected\":").Append(JA(sel.Select(f => f.Name))).Append(",\"skippedSlow\":").Append(JA(skipped.Select(f => f.Name)));
      sb.Append(",\"selectedTests\":").Append(sel.Sum(f => f.Count)).Append("}");
      Put(P(".plan.json"), sb.ToString());
      if (err != null || ListOnly) return;
      var filter = new Filter { testMode = TestMode.EditMode, assemblyNames = new[] { Asm },
                                groupNames = sel.Select(f => "^" + Regex.Escape(f.Full) + "[.(]").ToArray() };
      var cb = new Collector { Api = api, Sync = sync };
      api.RegisterCallbacks(cb);
      Put(Path.Combine(Dir, "active.json"), "{\"id\":" + J(Id) + "}");
      EditorApplication.CallbackFunction go = null;
      go = () => {
        EditorApplication.update -= go;
        try { cb.Clock.Start(); api.Execute(new ExecutionSettings(filter) { runSynchronously = sync }); }
        catch (Exception e) { cb.Finish("Execute threw " + e.GetType().Name + ": " + e.Message, 0); }
      };
      EditorApplication.update += go;
    } catch (Exception e) { Put(P(".plan.json"), "{\"error\":" + J("planning threw " + e.GetType().Name + ": " + e.Message) + "}"); }
  }

  class Collector : ICallbacks {
    public TestRunnerApi Api; public bool Sync;
    public System.Diagnostics.Stopwatch Clock = new System.Diagnostics.Stopwatch();
    int pass, fail, skip, inc; bool done;
    readonly List<string> fails = new List<string>(); readonly List<string> fx = new List<string>();
    public void RunStarted(ITestAdaptor t) { }
    public void TestStarted(ITestAdaptor t) { }
    public void TestFinished(ITestResultAdaptor r) {
      if (r.Test.IsSuite) {
        if (r.Test.TypeInfo != null && r.Test.Method == null)
          fx.Add("{\"name\":" + J(r.Test.TypeInfo.Type.Name) + ",\"seconds\":" + N(r.Duration) + "}");
        return;
      }
      if (r.TestStatus == TestStatus.Passed) pass++;
      else if (r.TestStatus == TestStatus.Skipped) skip++;
      else if (r.TestStatus == TestStatus.Failed) {
        fail++;
        fails.Add("{\"name\":" + J(r.Test.FullName) + ",\"message\":" + J(Trim(r.Message, 1200)) + ",\"stack\":" + J(Trim(r.StackTrace, 1200)) + "}");
      } else inc++;
    }
    public void RunFinished(ITestResultAdaptor r) { Finish(null, r.Duration); }
    public void Finish(string err, double unitySeconds) {
      if (done) return; done = true;
      try { Api.UnregisterCallbacks(this); } catch { }
      if (err == null && pass + fail + skip + inc == 0) err = "0 tests ran - the filter matched nothing";
      var sb = new StringBuilder("{");
      sb.Append("\"error\":").Append(J(err)).Append(",\"passed\":").Append(pass).Append(",\"failed\":").Append(fail)
        .Append(",\"skipped\":").Append(skip).Append(",\"inconclusive\":").Append(inc)
        .Append(",\"unitySeconds\":").Append(N(unitySeconds)).Append(",\"wallSeconds\":").Append(N(Clock.Elapsed.TotalSeconds))
        .Append(",\"sync\":").Append(B(Sync))
        .Append(",\"fixtures\":[").Append(string.Join(",", fx.ToArray())).Append("]")
        .Append(",\"failures\":[").Append(string.Join(",", fails.ToArray())).Append("]}");
      try { Put(P(".result.json"), sb.ToString()); } catch { }
      try { File.Delete(Path.Combine(Dir, "active.json")); } catch { }
    }
  }
}
'''


def git(args, cwd):
    return subprocess.run(["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=60)


def changed_paths(root, base):
    """Paths the working tree differs in from `base`, untracked files included."""
    out = set()
    d = git(["diff", "--name-only", base, "--"], root)
    out.update(p for p in d.stdout.splitlines() if p)
    u = git(["ls-files", "--others", "--exclude-standard"], root)
    out.update(p for p in u.stdout.splitlines() if p)
    return sorted(out)


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else ("es" if word.endswith("s") else "s"))


def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None


def stamps(root):
    return read_json(os.path.join(root, STAMPS)) or {}


def save_stamp(root, key, stamp, summary):
    data = stamps(root)
    data[key] = {"stamp": stamp, "at": time.time(), "summary": summary}
    try:
        with open(os.path.join(root, STAMPS), "w") as fh:
            json.dump(data, fh, indent=1)
    except Exception:
        pass                                            # a lost record only costs a re-run


def report(res, plan, meta):
    """Print the reduced verdict; return the exit code."""
    if res.get("error"):
        print(f"pf-tests: FAIL — {res['error']}")
        return 1
    fx = sorted(res.get("fixtures", []), key=lambda f: -f.get("seconds", 0))
    slowest = ", ".join(f"{f['name']} {f['seconds']:.1f}s" for f in fx[:4] if f.get("seconds", 0) >= 0.5)
    mode = "synchronous" if res.get("sync") else "ASYNC (an IEnumerator test is in the selection)"
    print(f"pf-tests: {res['passed']} passed / {res['failed']} failed / {res['skipped']} skipped"
          + (f" / {res['inconclusive']} inconclusive" if res.get("inconclusive") else "")
          + f" · {plural(len(plan.get('selected', [])), 'class')} · {res.get('wallSeconds', 0):.1f}s in Unity · {mode}")
    if slowest:
        print(f"   slowest: {slowest}")
    for f in res.get("failures", [])[:20]:
        msg = (f.get("message") or "").replace("\n", " | ")[:400]
        print(f"FAIL {f['name']}\n   {msg}")
        stack = [l.strip() for l in (f.get("stack") or "").splitlines() if l.strip()][:3]
        for l in stack:
            print(f"   {l if l.startswith('at ') else 'at ' + l}"[:200])
    if len(res.get("failures", [])) > 20:
        print(f"   … {len(res['failures']) - 20} more failures in {meta.get('result_path')}")
    return 0 if res["failed"] == 0 and res["inconclusive"] == 0 else 1


def describe_plan(plan, meta):
    sel, skipped = plan.get("selected", []), plan.get("skippedSlow", [])
    line = f"pf-tests: run {meta['id']} — {plural(len(sel), 'class')}, {plan.get('selectedTests', '?')} tests"
    if skipped:
        line += f"; Slow tier SKIPPED ({len(skipped)}: {', '.join(skipped)})"
        line += f" — {meta.get('slow_reason') or 'pass --slow to include it'}"
    elif meta.get("slow_reason"):
        line += f"; Slow tier included — {meta['slow_reason']}"
    print(line)


def wait_for_result(root, meta, budget, t_start, hard_deadline):
    res_path = meta["result_path"]
    while True:
        res = read_json(res_path)
        if res is not None:
            return res
        now = time.time()
        if now >= hard_deadline:
            print(f"pf-tests: no result after {now - meta['started']:.0f}s — Unity is still busy or the run died. "
                  f"Check `Tools/pf/pf-tests --wait {meta['id']}` once more; if it stays empty, "
                  f"read the console (pf-mcp console-get-logs).")
            return None
        if budget > 0 and now - t_start > budget:
            print(f"── INCOMPLETE: run {meta['id']} still running after {now - meta['started']:.0f}s "
                  f"(turn budget {budget}s). Not a failure. Continue in the next call:\n"
                  f"   Tools/pf/pf-tests --wait {meta['id']}")
            sys.exit(1)
        time.sleep(POLL)


def finish(root, meta, res):
    plan = read_json(meta["plan_path"]) or {}
    code = report(res, plan, meta)
    if code == 0 and meta.get("stamp"):
        save_stamp(root, meta["key"], meta["stamp"],
                   f"{res['passed']} passed · {len(plan.get('selected', []))} classes")
    return code


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("classes", nargs="*", help="test classes to run (short or full name)")
    ap.add_argument("--all", action="store_true", help="every class except the Slow tier")
    ap.add_argument("--auto", action="store_true",
                    help="--all, plus the Slow tier when the working tree touches a drawing path")
    ap.add_argument("--slow", action="store_true", help="include the Slow tier (with --all)")
    ap.add_argument("--list", action="store_true", help="list the classes and exit")
    ap.add_argument("--wait", metavar="RUN_ID", help="wait for a run a previous call left running")
    ap.add_argument("--base", default="HEAD", help="--auto: diff the working tree against this ref (default HEAD)")
    ap.add_argument("--assembly", default=DEFAULT_ASSEMBLY, help=f"test assembly (default {DEFAULT_ASSEMBLY})")
    ap.add_argument("--category", default=SLOW_CATEGORY, help=f"the Slow tier's NUnit category (default {SLOW_CATEGORY})")
    ap.add_argument("--rerun", action="store_true", help="run even when the inputs match the last green run")
    ap.add_argument("--turn-budget", type=int, default=240,
                    help="seconds before a still-running run is left to `--wait` (default 240; 0 = block)")
    ap.add_argument("--timeout", type=int, default=1200, help="seconds before giving up on a run's result (default 1200)")
    ap.add_argument("--wait-ready-max", type=int, default=600, help="seconds to wait for a busy Editor first (default 600)")
    a = ap.parse_args()
    t_start = time.time()

    root = git(["rev-parse", "--show-toplevel"], os.getcwd()).stdout.strip()
    if not root or not os.path.isdir(os.path.join(root, "ProjectSettings")):
        sys.exit("pf-tests: run it from inside a Unity project's git checkout")
    os.chdir(root)
    os.makedirs(STATE_DIR, exist_ok=True)

    if a.wait:
        meta = read_json(os.path.join(STATE_DIR, a.wait + ".meta.json"))
        if not meta:
            sys.exit(f"pf-tests: no run {a.wait} under {STATE_DIR}")
        res = wait_for_result(root, meta, a.turn_budget, t_start, meta["started"] + a.timeout)
        if res is None:
            sys.exit(1)
        describe_plan(read_json(meta["plan_path"]) or {}, meta)
        sys.exit(finish(root, meta, res))

    modes = sum(bool(x) for x in (a.classes, a.all, a.auto, a.list))
    if modes != 1:
        ap.error("give exactly one of: CLASS…, --all, --auto, --list")

    active = read_json(os.path.join(STATE_DIR, "active.json"))
    if active and not a.list:
        prev = read_json(os.path.join(STATE_DIR, active.get("id", "") + ".meta.json")) or {}
        if prev and time.time() - prev.get("started", 0) < a.timeout and \
                not os.path.exists(prev.get("result_path", "")):
            print(f"pf-tests: run {active['id']} is still running. Never start a second one: "
                  f"`Tools/pf/pf-tests --wait {active['id']}`")
            sys.exit(1)

    include_slow, slow_reason = a.slow, None
    if a.auto:
        rx = re.compile(os.environ.get("PF_TESTS_DRAW_PATHS", DRAW_PATHS))
        hits = [p for p in changed_paths(root, a.base) if rx.search(p)]
        include_slow = bool(hits)
        slow_reason = (f"the diff draws ({', '.join(hits[:3])}{' …' if len(hits) > 3 else ''})" if hits
                       else f"the diff vs {a.base} touches no drawing path")
    elif a.all and not a.slow:
        slow_reason = "pass --slow (or --auto) to include it"

    want = [] if (a.all or a.auto or a.list) else a.classes
    key = f"{a.assembly}|{','.join(sorted(want)) if want else 'ALL'}|slow={include_slow or bool(want)}"
    mcp = load_pf_mcp()
    stamp_root, stamp = (None, None) if a.list else mcp.inputs_stamp()
    last = stamps(root).get(key)
    if stamp and not a.rerun and last and last.get("stamp") == stamp:
        print(f"pf-tests: reused — every input is byte-identical to the last green run of this selection at "
              f"{time.strftime('%H:%M:%S', time.localtime(last['at']))} ({last.get('summary', '?')}). "
              f"--rerun to force.")
        sys.exit(0)

    ready, waited, probes = mcp.wait_ready(a.wait_ready_max)
    if not ready:
        sys.exit(f"pf-tests: the Editor did not come free within {a.wait_ready_max}s ({probes} probes) — BUSY, not broken")

    run_id = time.strftime("%H%M%S") + "-" + uuid.uuid4().hex[:6]
    state = os.path.join(root, STATE_DIR)
    meta = {"id": run_id, "key": key, "stamp": stamp, "started": time.time(), "slow_reason": slow_reason,
            "plan_path": os.path.join(state, run_id + ".plan.json"),
            "result_path": os.path.join(state, run_id + ".result.json")}
    with open(os.path.join(state, run_id + ".meta.json"), "w") as fh:
        json.dump(meta, fh)

    code_text = (CSHARP.replace("__DIR__", cs(state)).replace("__ID__", cs(run_id))
                 .replace("__ASM__", cs(a.assembly)).replace("__CAT__", cs(a.category))
                 .replace("__WANT__", ", ".join(cs(w) for w in want))
                 .replace("__SLOW__", "true" if include_slow else "false")
                 .replace("__LIST__", "true" if a.list else "false"))
    arg = json.dumps({"className": "PfTestsRun", "methodName": "Main", "csharpCode": code_text})

    answer = None
    for attempt in range(4):
        code, raw, took = mcp.cli("script-execute", arg, 120)
        d = mcp.payload(raw)
        answer = str(mcp.walk(d, {"value"}) or "") if d else ""
        if code == 0 and answer.startswith("STARTED"):
            break
        if answer in ("COMPILING",) or answer.startswith("BUSY"):
            mcp.wait_ready(a.wait_ready_max)                # a refresh kicked a compile: let it land
            continue
        detail = answer or raw.strip()[-600:]
        print(f"pf-tests: could not start — {detail}")
        sys.exit(2)
    else:
        sys.exit(f"pf-tests: the Editor kept compiling ({answer}); run `Tools/pf/typecheck.sh --changed`, then retry")

    deadline = time.time() + 90
    while read_json(meta["plan_path"]) is None:
        if time.time() > deadline:
            sys.exit(f"pf-tests: Unity never planned run {run_id} (RetrieveTestList did not call back in 90 s)")
        time.sleep(POLL)
    plan = read_json(meta["plan_path"])
    if plan.get("error"):
        print(f"pf-tests: {plan['error']}")
        sys.exit(2)
    if a.list:
        for f in plan.get("fixtures", []):
            tags = ("  [Slow]" if f.get("slow") else "") + ("  [async]" if f.get("async") else "")
            print(f"{f['name']:44} {f['tests']:4} tests{tags}")
        total = sum(f["tests"] for f in plan.get("fixtures", []))
        print(f"── {len(plan.get('fixtures', []))} classes, {total} tests in {a.assembly}")
        sys.exit(0)
    describe_plan(plan, meta)
    res = wait_for_result(root, meta, a.turn_budget, t_start, meta["started"] + a.timeout)
    if res is None:
        sys.exit(1)
    sys.exit(finish(root, meta, res))


if __name__ == "__main__":
    main()
