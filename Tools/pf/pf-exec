"""THE BATCHED SHELL DOOR — N shell commands in ONE turn, each capped, one labelled report.

Any command the shell can run belongs here: reads and greps, but equally `dotnet build`,
`dotnet test`, a gate script, a git query, a uuid generator. Formerly `pf-probe`; that name
read as inspection-only, which is exactly the mistake this tool exists to prevent. The old
path still works through a shim.

    pf-exec --cap 2k <<'EOF'
    sig     : rg -n "class RowBadgeView" Assets/Scripts
    tokens  : read Assets/Scripts/Design/Tokens.cs:1-40
    callers : rg -n "ItemViewFactory" Assets/Scripts -l
    csproj  : cat SkuHeadlessTests/*.csproj
    pkgs    : ls ~/.nuget/packages | grep -i nunit
    EOF

Every turn re-sends the whole conversation, so five commands in five turns bill the
context five times — measured on this project, a 26-command exploration ran as 26
separate model calls when it could have been two. The cap matters as much as the
batching: a token pulled into context early is re-sent on every later turn, so an
uncapped batch can cost more than the turns it saved.

This is also why several parallel Bash calls in one message are NOT equivalent: the
message saves the turns, but nothing caps or reduces what comes back. A `dotnet build`
that floods your context is paid for until the session ends.

Items run in PARALLEL and must be independent — nothing here may depend on another
item's output. For an ordered Unity sequence use pf-mcp, which sequences and can stop
on failure.

For an ordered SHELL sequence — build, then test, then gate — add --ordered (run in
order, one at a time) and --stop-on-fail (a failed item SKIPs everything behind it, so
a red compile never pays for the test run behind it). --reduce shrinks each result in
the shell before it reaches context: `verdict` keeps each leg's PASS/FAIL,
the test counts, the failing names and any compiler error, dropping the rest; `auto` picks a reducer per item from
the command; `tail` keeps the last lines. Reduction runs BEFORE the cap, so a reduced
item almost never truncates.

    pf-exec --ordered --stop-on-fail --reduce auto <<'EOF'
    build : dotnet build -nologo
    test  : dotnet test -nologo
    gate  : sh Tools/pf/gate.sh
    EOF
"""
import argparse, os, re, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor

READ = re.compile(r"^read\s+(?P<path>[^\s:]+)(?::(?P<a>\d+)(?:-(?P<b>\d+))?)?\s*$")

# --- reducers: shrink a result in the shell, before it reaches context ----------
# One `dotnet test` result runs 2-5k chars; what a caller needs is the counts, the
# names that failed, and the compiler errors. Measured on one story: 64 build/test
# calls carried 178k chars, re-sent at 50x amplification for the rest of the session.
# A gate or a test run prints a verdict per leg and buries it in restore chatter,
# VSTest banners and build paths. Keep the verdicts, the failing names and the
# compiler errors; drop the rest. Measured on one story: 64 build/test calls carried
# 178k chars, re-sent at 50x amplification for the rest of the session.
VERDICT_KEEP = re.compile(
    r"Passed!|Failed!"                       # dotnet test summary
    r"|error [A-Z]{2}\d+"                    # compiler / msbuild errors
    r"|^\s*(Failed|Error Message|Assert|Stack Trace)\b"   # failing-test detail
    r"|\b(PASS|FAIL|WARN|SKIP|ERROR)\b"      # gate-script leg verdicts
    r"|^OK\s|^-{3}\s"                        # typecheck per-assembly lines
    r"|ALL LEGS|\(exit [0-9]+\)")


def reduce_verdict(out):
    keep = [ln for ln in out.splitlines() if VERDICT_KEEP.search(ln)]
    return "\n".join(keep) if keep else out


def reduce_tail(out, n=25):
    return "\n".join(out.splitlines()[-n:])


REDUCERS = {"none": lambda o: o, "verdict": reduce_verdict, "tail": reduce_tail}


def pick_reducer(name, cmd):
    """`auto` chooses from the command; anything else is taken literally."""
    if name != "auto":
        return REDUCERS.get(name, REDUCERS["none"])
    if re.search(r"\bdotnet\s+(test|build)\b|\bgate[\w.-]*\.sh\b|\btypecheck", cmd):
        return reduce_verdict
    return REDUCERS["none"]


def human(n):
    return f"{n/1000:.1f}k" if n >= 1000 else f"{n}B"


def size(s):
    """'2k' / '500' / '8K' -> int bytes."""
    s = str(s).strip().lower()
    return int(float(s[:-1]) * 1000) if s.endswith("k") else int(s)


def read_file(m):
    path, a, b = m["path"], m["a"], m["b"]
    if not os.path.exists(path):
        return 2, f"pf-exec: no such file: {path}"
    with open(path, errors="replace") as fh:
        lines = fh.readlines()
    if a:
        lo = max(1, int(a))
        hi = int(b) if b else lo
        sel, off = lines[lo - 1:hi], lo
    else:
        sel, off = lines, 1
    return 0, "".join(f"{off+i:5d} {ln}" for i, ln in enumerate(sel))


def run(item, cap, timeout, reduce_name="none"):
    label, cmd = item
    reducer = pick_reducer(reduce_name, cmd)
    t0 = time.time()
    m = READ.match(cmd)
    try:
        if m:
            code, out = read_file(m.groupdict())
        else:
            p = subprocess.run(cmd, shell=True, capture_output=True, timeout=timeout)
            code = p.returncode
            out = (p.stdout + p.stderr).decode(errors="replace")
    except subprocess.TimeoutExpired:
        code, out = 124, f"pf-exec: timed out after {timeout}s"
    except Exception as e:                                   # never kill the batch
        code, out = 1, f"pf-exec: {type(e).__name__}: {e}"

    out = reducer(out) if reducer else out
    raw = len(out)
    trunc = raw > cap
    if trunc:
        out = out[:cap] + f"\n   [cut {human(raw-cap)} — rerun this item alone with --cap {human(raw*2)} if needed]\n"
    return dict(label=label, code=code, out=out, raw=raw, kept=len(out),
                trunc=trunc, empty=not out.strip(), ms=int(1000 * (time.time() - t0)))


def parse(text):
    items, n = [], 0
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        n += 1
        label, sep, cmd = line.partition(":")
        if not sep or not cmd.strip():           # no label — the whole line is the command
            label, cmd = f"item{n}", line
        items.append((label.strip()[:14], cmd.strip()))
    return items


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--cap", default="2k", help="max output bytes PER ITEM (default 2k)")
    ap.add_argument("--timeout", type=int, default=60, help="per-item seconds (default 60)")
    ap.add_argument("--jobs", type=int, default=8)
    ap.add_argument("--ordered", action="store_true",
                    help="run items IN ORDER, one at a time (default: parallel)")
    ap.add_argument("--stop-on-fail", action="store_true",
                    help="implies --ordered; a failed item SKIPs everything behind it")
    ap.add_argument("--reduce", default="none", choices=sorted(REDUCERS) + ["auto"],
                    help="shrink each result before the cap (default none)")
    a = ap.parse_args()

    items = parse(sys.stdin.read())
    if not items:
        sys.exit("pf-exec: nothing on stdin. Feed it 'label : command' lines via a heredoc.")
    cap = size(a.cap)

    if a.ordered or a.stop_on_fail:
        res, stopped = [], False
        for it in items:
            if stopped:
                res.append(dict(label=it[0], code=0, out="", raw=0, kept=0,
                                trunc=False, empty=True, ms=0, skipped=True))
                continue
            r = run(it, cap, a.timeout, a.reduce)
            res.append(r)
            if a.stop_on_fail and r["code"] != 0:
                stopped = True
    else:
        with ThreadPoolExecutor(max_workers=a.jobs) as ex:
            res = list(ex.map(lambda i: run(i, cap, a.timeout, a.reduce), items))

    for i, r in enumerate(res, 1):
        if r.get("skipped"):
            status = "SKIPPED (an earlier item failed)"
        elif r["empty"] and r["code"] == 0:
            status = "EMPTY"
        elif r["code"] != 0:
            status = f"exit {r['code']}"
        elif r["trunc"]:
            status = f"TRUNCATED {human(r['raw'])}->{human(r['kept'])}"
        else:
            status = "ok"
        print(f"\n── [{i}] {r['label']:14s} {status:26s} {human(r['kept']):>7} {r['ms']:5d}ms")
        if not r["empty"]:
            print(r["out"].rstrip("\n"))

    kept = sum(r["kept"] for r in res)
    ok = sum(r["code"] == 0 and not r["empty"] for r in res)
    print(f"\n── {human(kept)} (~{kept//4} tok) / {len(res)} items"
          f" · {ok} ok"
          f" · {sum(r['trunc'] for r in res)} truncated"
          f" · {sum(r['empty'] and r['code']==0 for r in res)} empty"
          f" · {sum(r['code']!=0 for r in res)} fail"
          f"{' · ' + str(sum(bool(r.get('skipped')) for r in res)) + ' skipped' if any(r.get('skipped') for r in res) else ''}")


if __name__ == "__main__":
    main()
