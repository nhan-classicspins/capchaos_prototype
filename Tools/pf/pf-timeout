"""Put a hard wall-clock cap on ONE command, and kill its whole process group.

    pf-timeout 300 dotnet test SkuHeadlessTests/Foo.csproj --filter "TestCategory!=Slow"
    pf-timeout 90  sh Tools/pf/gate.sh

Why this exists at all: **macOS ships no `timeout(1)`**. An agent that reaches for
`timeout 480 dotnet test …` gets `command not found`, loses the turn, and then usually runs the
command uncapped — which is how a single unfiltered test invocation sat at 98% CPU for twenty
minutes on this project while three separate turns waited on it.

`SECONDS` is the cap. Exit code is the command's own, or **124** when the cap fired — the same
code GNU `timeout` uses, so `|| echo TIMED_OUT` style checks port unchanged. stdout/stderr are
inherited, not captured: cap the OUTPUT with `pf-exec --cap`, cap the TIME here.

The child is started in its own process group and the group is signalled — TERM, then KILL after
a short grace. That part is not a detail: `dotnet test` forks a `testhost` that outlives a TERM to
the parent, and an orphaned testhost keeps burning a core and holds the next run out with
"another test run is in progress".
"""
import os
import signal
import subprocess
import sys
import time

GRACE_SECONDS = 5


def die(message):
    sys.stderr.write("pf-timeout: " + message + "\n")
    raise SystemExit(2)


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        sys.stderr.write(__doc__)
        raise SystemExit(2)

    try:
        cap = float(argv[0])
    except ValueError:
        die("first argument must be the cap in seconds, got '" + argv[0] + "'")
    if cap <= 0:
        die("the cap must be positive")

    command = argv[1:]
    if not command:
        die("nothing to run — pf-timeout SECONDS COMMAND [ARG...]")

    try:
        child = subprocess.Popen(command, start_new_session=True)
    except FileNotFoundError:
        die("command not found: " + command[0])
    except OSError as error:
        die(str(error))

    try:
        return child.wait(timeout=cap)
    except subprocess.TimeoutExpired:
        pass
    except KeyboardInterrupt:
        signal_group(child, signal.SIGINT)
        return 130

    sys.stderr.write("pf-timeout: cap of %gs reached — signalling the process group\n" % cap)
    signal_group(child, signal.SIGTERM)
    deadline = time.time() + GRACE_SECONDS
    while time.time() < deadline:
        if child.poll() is not None:
            break
        time.sleep(0.1)
    if child.poll() is None:
        signal_group(child, signal.SIGKILL)
        child.wait()
    return 124


def signal_group(child, sig):
    """Signal the child's whole group, falling back to the child alone."""
    try:
        os.killpg(os.getpgid(child.pid), sig)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            child.send_signal(sig)
        except ProcessLookupError:
            pass


if __name__ == "__main__":
    raise SystemExit(main())
