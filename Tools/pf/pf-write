"""Apply N file mutations in ONE turn, all-or-nothing.

    pf-write <<'EOF'
    [
      {"op":"edit",  "path":"src/A.cs", "old":"var x = 1;", "new":"var x = 2;"},
      {"op":"edit",  "path":"src/B.cs", "old":"foo(", "new":"bar(", "count":3},
      {"op":"write", "path":"src/C.cs", "text":"// whole new file\n"},
      {"op":"delete","path":"src/Old.cs"}
    ]
    EOF

Why this exists, and why it is not pf-exec. Batching writes needs no tool: the host
runs every Write/Edit call a single assistant message carries before it calls you
again, so N files created together already cost one turn. What a message cannot give
you is ATOMICITY. That is what this tool is for.

ALL-OR-NOTHING, and that is the opposite of pf-exec on purpose. pf-exec lets a failing
item stand so the other nine still report. A half-applied batch of mutations is the worst
outcome there is: every item is validated first, nothing is touched until all of them
pass, and any error during application rolls the whole tree back.

`edit` replaces EXACT text and requires exactly `count` occurrences (default 1) — an
ambiguous match is refused, never guessed. `write` creates or replaces a whole file.
`append` adds to the end. `delete` removes one. Paths must sit inside the working
directory. --dry-run validates and reports without writing.

This tool is for mutation only. Reading belongs in pf-exec; driving the Editor belongs
in pf-mcp; and a test run stays its own turn, because its result is a decision.
"""
import argparse, json, os, sys


def human(n):
    return f"{n/1000:.1f}k" if n >= 1000 else f"{n}B"


def load(text):
    try:
        doc = json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"pf-write: stdin is not valid JSON: {e}\n"
                 "Feed it a JSON array of {op, path, ...} objects via a heredoc.")
    if isinstance(doc, dict):
        doc = [doc]
    if not isinstance(doc, list) or not doc:
        sys.exit("pf-write: expected a non-empty JSON array of operations.")
    return doc


def resolve(root, path):
    """Absolute path, refused when it escapes the working directory."""
    full = os.path.realpath(os.path.join(root, path))
    if full != root and not full.startswith(root + os.sep):
        return None, "path escapes the working directory"
    return full, None


def plan(items, root):
    """Validate every item. Returns (plans, errors) — nothing is written here."""
    plans, errors = [], []
    # Later items must see what earlier ones in the same batch intend to leave behind.
    staged = {}
    for i, it in enumerate(items, 1):
        if not isinstance(it, dict):
            errors.append((i, "?", "item is not an object")); continue
        op, path = it.get("op"), it.get("path")
        if op not in ("edit", "write", "append", "delete"):
            errors.append((i, str(path), f"unknown op {op!r}")); continue
        if not isinstance(path, str) or not path:
            errors.append((i, "?", "missing 'path'")); continue
        full, err = resolve(root, path)
        if err:
            errors.append((i, path, err)); continue

        if op == "delete":
            if full not in staged and not os.path.isfile(full):
                errors.append((i, path, "no such file")); continue
            plans.append(dict(n=i, op=op, path=path, full=full, after=None))
            staged[full] = None
            continue

        if op == "write":
            text = it.get("text")
            if not isinstance(text, str):
                errors.append((i, path, "'write' needs a string 'text'")); continue
            if full in staged:
                before = staged[full] or ""
            elif os.path.isfile(full):
                with open(full, errors="replace") as fh:
                    before = fh.read()
            else:
                before = ""
            plans.append(dict(n=i, op=op, path=path, full=full, after=text,
                              delta=text.count("\n") - before.count("\n"),
                              bytes=len(text) - len(before)))
            staged[full] = text
            continue

        # edit / append need the current content
        if full in staged:
            before = staged[full]
            if before is None:
                errors.append((i, path, "the batch deletes this file earlier")); continue
        elif os.path.isfile(full):
            with open(full, errors="replace") as fh:
                before = fh.read()
        else:
            errors.append((i, path, "no such file")); continue

        if op == "append":
            text = it.get("text")
            if not isinstance(text, str):
                errors.append((i, path, "'append' needs a string 'text'")); continue
            after = before + text
        else:
            old, new = it.get("old"), it.get("new")
            if not isinstance(old, str) or not old:
                errors.append((i, path, "'edit' needs a non-empty string 'old'")); continue
            if not isinstance(new, str):
                errors.append((i, path, "'edit' needs a string 'new'")); continue
            want = it.get("count", 1)
            if not isinstance(want, int) or want < 1:
                errors.append((i, path, "'count' must be a positive integer")); continue
            found = before.count(old)
            if found == 0:
                errors.append((i, path, "'old' text not found — read the file from disk, "
                                        "it is not what the diff says")); continue
            if found != want:
                errors.append((i, path, f"'old' occurs {found}x, 'count' says {want} — "
                                        "widen 'old' until it is unique, or set 'count'")); continue
            after = before.replace(old, new)

        plans.append(dict(n=i, op=op, path=path, full=full, after=after,
                          delta=after.count("\n") - before.count("\n"),
                          bytes=len(after) - len(before)))
        staged[full] = after
    return plans, errors


def apply(plans):
    """Write everything, rolling the whole tree back on any failure."""
    undo = []
    try:
        for p in plans:
            full = p["full"]
            had = os.path.isfile(full)
            undo.append((full, open(full, errors="replace").read() if had else None, had))
            if p["after"] is None:
                os.remove(full)
            else:
                os.makedirs(os.path.dirname(full) or ".", exist_ok=True)
                with open(full, "w") as fh:
                    fh.write(p["after"])
        return None
    except Exception as e:
        for full, content, had in reversed(undo):
            try:
                if had:
                    with open(full, "w") as fh:
                        fh.write(content)
                elif os.path.isfile(full):
                    os.remove(full)
            except Exception:
                pass
        return f"{type(e).__name__}: {e}"


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--dry-run", action="store_true",
                    help="validate and report, write nothing")
    a = ap.parse_args()

    root = os.path.realpath(os.getcwd())
    items = load(sys.stdin.read())
    plans, errors = plan(items, root)

    if errors:
        for n, path, why in errors:
            print(f"── [{n}] {path[:40]:40s} REFUSED  {why}")
        print(f"\n── 0 of {len(items)} applied — the batch is all-or-nothing, "
              f"the tree is unchanged. Fix the item(s) above and resend the whole batch.")
        sys.exit(1)

    if a.dry_run:
        for p in plans:
            print(f"── [{p['n']}] {p['path'][:40]:40s} would {p['op']}")
        print(f"\n── {len(plans)} of {len(items)} valid · nothing written (--dry-run)")
        return

    err = apply(plans)
    if err:
        print(f"── apply failed: {err}")
        print(f"\n── 0 of {len(items)} applied — every file was rolled back.")
        sys.exit(2)

    for p in plans:
        verb = {"edit": "edited", "write": "written", "append": "appended"}
        if p["op"] == "delete":
            what = "deleted"
        else:
            d = p.get("delta", 0)
            what = f"{verb[p['op']]:9s} {d:+d} lines, {human(abs(p.get('bytes', 0)))}"
        print(f"── [{p['n']}] {p['path'][:40]:40s} {what}")
    print(f"\n── {len(plans)} of {len(items)} applied in one turn")


if __name__ == "__main__":
    main()
